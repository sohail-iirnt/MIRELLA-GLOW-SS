rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber','customer','items','total','status','paymentStatus','paymentMethod'])
        && request.resource.data.status == 'new'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.customer.keys().hasAll(['name','phone','address','city','state','pincode'])
        && request.resource.data.items.size() > 0
        && request.resource.data.total >= 0;
      allow read, update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
  }
}
